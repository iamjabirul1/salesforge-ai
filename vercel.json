{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/agents/run/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/agents/stream/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/agents/status/[id]/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/resend/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/process-queue/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/cal/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/email-events/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/reply-received/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With"
        }
      ]
    }
  ]
}
